{
  "name": "watchboard-front",
  "version": "1.0.0",
  "description": "A local dashboard for software releases and game prices.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/David-H-Afonso/Watchboard.Front.git" },
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <23 || >=24.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5333 --strictPort",
